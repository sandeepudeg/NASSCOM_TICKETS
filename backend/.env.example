# Tickets Folder Feature - Environment Configuration
# Copy to .env and adjust values as needed

# Application
APP_NAME=TicketsFolder
APP_VERSION=1.0.0
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tickets
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Vector Store (pgvector)
VECTOR_DIMENSION=384

# API
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Multi-folder assignment (default: false)
MULTI_FOLDER_ASSIGNMENT=false

# AI/ML - Classification
ESCALATION_THRESHOLD=0.65
CLASSIFICATION_TIMEOUT_SECONDS=5

# AI/ML - Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# AI/ML - RAG
SIMILARITY_THRESHOLD=0.70
TOP_K_SIMILAR_TICKETS=5

# AI/ML - Pattern Detection
PATTERN_WINDOW_DAYS=7
PATTERN_SIMILARITY_THRESHOLD=0.80
PATTERN_CLUSTER_MIN_SIZE=3

# AI/ML - Retraining
RETRAIN_SCHEDULE_CRON=0 2 * * 0

# PII Scrubbing (test env only - blocked in production)
DISABLE_PII_SCRUBBING=false

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Groq Cloud (Recommended for HF Spaces)
# Get a free key at https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Object Storage (MinIO/S3)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=tickets

# Authentication
AUTH_SERVICE_URL=http://localhost:8080/auth
TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_HOURS=8

# Webhook (for escalation notifications)
ESCALATION_WEBHOOK_URL=http://localhost:9000/webhook/escalation
WEBHOOK_RETRY_MAX=3
WEBHOOK_RETRY_INITIAL_DELAY_SECONDS=10

# Rate Limiting
RATE_LIMIT_STANDARD=300
RATE_LIMIT_SERVICE_ACCOUNT=1000

# Observability
PROMETHEUS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
JAEGER_ENDPOINT=http://localhost:14268
LOKI_ENDPOINT=http://localhost:3100

# Flask Admin Configuration (for HF Spaces deployment)
# Required for Flask admin interface
SECRET_KEY=your-secret-key-here
FLASK_ENV=production
DEBUG=false
LOG_FORMAT=json
LOG_LEVEL=INFO

# HF Spaces Configuration
# API_BASE_URL should point to your deployed FastAPI backend
# Example: https://your-api-backend.herokuapp.com or https://your-domain.com/api
API_BASE_URL=http://api:8000

# CORS Configuration
# For HF Spaces, this will be auto-detected as https://sandeepudeg-tickets.hf.space
# For local development, use http://localhost:5001
CORS_ORIGINS=http://localhost:5001

# Server Configuration
# PORT=7860 is required for HF Spaces, 5000 for local Docker Compose
PORT=7860
HOST=0.0.0.0

# HF Spaces Environment Variables (auto-detected)
# SPACE_ID=sandeepudeg/tickets (set automatically by HF Spaces)
# These are provided automatically by HF Spaces platform